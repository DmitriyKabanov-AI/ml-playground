# =====================================================================
#  .gitignore — исключаем из git всё, что тяжело и/или секретно
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
.Python
build/
wheelhouse/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- venv ----------
.venv/
venv/
env/
ENV/
.python-version

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.nbconvert.ipynb
.ipython/

# ---------- Секрет с токеном ----------
config/.env

# ---------- ML модели (слишком большие для git) ----------
models/**/*.joblib
models/**/*.pkl
models/**/*.h5
models/**/*.pt
models/**/*.onnx
models/**/*.pb
*.joblib

# ---------- Датасеты (слишком большие для git) ----------
data/**/*.csv
data/**/*.parquet
data/**/*.zip
data/**/*.gz
data/**/*.tar
*.csv.gz
*.parquet

# Но .gitkeep в data/ и models/ оставляем — они держат структуру папок
!data/**/.gitkeep
!models/**/.gitkeep

# ---------- Node / frontend ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Next.js ----------
# Билд-кэш и производные артефакты — регенерируются при каждом запуске dev/build
frontend/.next/
.next/
out/
frontend/out/

# TypeScript incremental build info — тоже кэш
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Логи / временное ----------
*.log
*.tmp
*.bak
tmp/
temp/
structure.txt
preview.log
preview.err.log
ps-output.txt

# ---------- Trash / корзина ----------
.Trash-*/
.Trash-0/