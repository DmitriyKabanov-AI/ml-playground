                <label className="select-field">
                  <span>Модель прогноза</span>
                  <select
                    value={selectedWalmartModel}
                    onChange={(e) => setSelectedWalmartModel(e.target.value)}
                  >
                    {walmart.models.map((m) => (
                      <option key={m.name} value={m.name}>{m.name}</option>
                    ))}
                  </select>
                </label>
                <div className="horizon-control">
                  <span>Горизонт</span>
                  <div className="segmented">
                    {([4, 8, 13] as const).map((v) => (
                      <button
                        key={v}
                        type="button"
                        className={walmartHorizon === v ? 'active' : ''}
                        onClick={() => setWalmartHorizon(v)}
                      >{v} нед.</button>
                    ))}
                  </div>
                </div>
                <div className="toggle-controls">
                  <button
                    type="button"
                    className={`toggle-chip ${walmartShowConfidence ? 'active' : ''}`}
                    onClick={() => setWalmartShowConfidence((v) => !v)}
                  >
                    <span className="toggle-check">{walmartShowConfidence && <Check size={11} />}</span>
                    {' '}95% интервал
                  </button>
                  <button
                    type="button"
                    className={`toggle-chip ${walmartShowHolidays ? 'active' : ''}`}
                    onClick={() => setWalmartShowHolidays((v) => !v)}
                  >
                    <span className="toggle-check">{walmartShowHolidays && <Check size={11} />}</span>
                    {' '}Праздники
                  </button>
                </div>
              </section>

              {/* ── Metrics ───────────────────────────────────────── */}
              <section className="metrics-grid">
                <MetricCard
                  label="WMAE · ошибка"
                  value={formatSales(walmartHorizonStats.wmae)}
                  note="Праздничные недели имеют больший вес"
                  tone="cyan"
                  icon={<Activity size={17} />}
                />
                <MetricCard
                  label="MAPE"
                  value={`${formatNumber(currentWalmartModel?.metrics.mape ?? 0, 2)}%`}
                  note="Ошибка на отложенном отрезке"
                  tone="green"
                  icon={<TrendingUp size={17} />}
                />
                <MetricCard
                  label={`Прогноз · ${walmartHorizon} нед.`}
                  value={formatSales(walmartHorizonStats.forecastSum)}
                  note="Ожидаемая сумма продаж магазина"
                  tone="amber"
                  icon={<ShoppingCart size={17} />}
                />
                <MetricCard
                  label="YoY · к прошлому году"
                  value={formatPercent(walmartHorizonStats.yoy)}
                  note={`Сравнение с теми же неделями · ${formatSales(walmartHorizonStats.lastYearSum)}`}
                  tone="purple"
                  icon={walmartHorizonStats.yoy >= 0 ? <ArrowUpRight size={17} /> : <ArrowDownRight size={17} />}
                />
              </section>

              {/* ── Weekly chart ──────────────────────────────────── */}
              <Card
                title="Недельные продажи: факт и прогноз"
                subtitle={`Store ${walmartActiveStoreId ?? '—'} · ${currentWalmartModel?.name ?? '—'} · жёлтые маркеры — праздничные недели`}
                className="sales-chart-panel"
                right={
                  <div className="chart-legend">
                    <span><i className="legend-line actual-line" /> Факт</span>
                    <span><i className="legend-line forecast-line" /> Прогноз</span>
                    {walmartShowConfidence && <span><i className="legend-line interval-line" /> 95% интервал</span>}
                  </div>
                }
              >
                <div className="chart-area sales-chart">
                  <ResponsiveContainer width="100%" height="100%">
                    <ComposedChart data={walmartStoreSeries} margin={{ top: 14, right: 18, bottom: 8, left: 6 }}>
                      <defs>
                        <linearGradient id="salesGradient" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stopColor={chartPalette.cyan} stopOpacity={0.2} />
                          <stop offset="100%" stopColor={chartPalette.cyan} stopOpacity={0.01} />
                        </linearGradient>
                      </defs>
                      <CartesianGrid strokeDasharray="3 5" stroke="var(--chart-grid)" vertical={false} />
                      <XAxis
                        dataKey="date"
                        tickFormatter={formatAxisDate}
                        minTickGap={24}
                        tick={{ fill: 'var(--muted)', fontSize: 10 }}
                        tickLine={false} axisLine={false}
                      />
                      <YAxis
                        tickFormatter={(v) => `$${(v / 1_000_000).toFixed(1)}M`}
                        tick={{ fill: 'var(--muted)', fontSize: 10 }}
                        tickLine={false} axisLine={false} width={54}
                      />
                      <Tooltip content={<GenericTooltip valueFormatter={(v) => formatUsd(Number(v))} />} />
                      {walmartShowConfidence && (
                        <>
                          <Line dataKey="low"  stroke={chartPalette.cyan} strokeOpacity={0.35} strokeDasharray="4 5" strokeWidth={1} dot={false} activeDot={false} connectNulls={false} />
                          <Line dataKey="high" stroke={chartPalette.cyan} strokeOpacity={0.35} strokeDasharray="4 5" strokeWidth={1} dot={false} activeDot={false} connectNulls={false} />
                        </>
                      )}
                      <Area type="monotone" dataKey="actual" stroke={undefined} fill="url(#salesGradient)" fillOpacity={0.15} connectNulls={false} activeDot={false} />
                      <Line type="monotone" dataKey="actual"    name="Факт"    stroke="var(--text)"       strokeWidth={2}   dot={false} activeDot={{ r: 4 }} connectNulls={false} />
                      <Line type="monotone" dataKey="predicted" name="Прогноз" stroke={chartPalette.cyan} strokeWidth={2.6} dot={false} activeDot={{ r: 4 }} connectNulls={false} />
                      {walmartShowHolidays && walmartStoreSeries.filter((r) => r.holiday).map((r) => (
                        <ReferenceLine
                          key={r.date}
                          x={r.date}
                          stroke={chartPalette.amber}
                          strokeDasharray="3 4"
                          strokeOpacity={0.8}
                          label={{ value: r.holiday?.icon, position: 'insideTop', fill: chartPalette.amber, fontSize: 13 }}
                        />
                      ))}
                    </ComposedChart>
                  </ResponsiveContainer>
                </div>
                <div className="chart-footnote">
                  <span><i className="legend-line actual-line" /> История до последней фактической недели</span>
                  <span><i className="legend-line forecast-line" /> Прогноз выбранной модели · горизонт {walmartHorizon} нед.</span>
                </div>
              </Card>

              {/* ── Model comparison + Insights ───────────────────── */}
              <section className="two-column walmart-detail-grid">
                <Card
                  title="Сравнение моделей"
                  subtitle="MAPE на отложенной выборке · меньше лучше"
                  right={<span className="small-tag">BEST: {walmartBest?.name ?? '—'}</span>}
                >
                  <div className="chart-area chart-medium">
                    <ResponsiveContainer width="100%" height="100%">
                      <BarChart
                        data={walmartModelsComparison}
                        layout="vertical"
                        margin={{ top: 4, right: 26, bottom: 4, left: 6 }}
                      >
                        <CartesianGrid strokeDasharray="3 5" horizontal={false} stroke="var(--chart-grid)" />
                        <XAxis type="number" tickFormatter={(v) => `${v}%`} tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <YAxis type="category" dataKey="name" width={108} tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <Tooltip content={<GenericTooltip valueFormatter={(v) => `${formatNumber(v, 2)}%`} />} />
                        <Bar dataKey="mape" name="MAPE" radius={[0, 5, 5, 0]} barSize={17}>
                          {walmartModelsComparison.map((model) => (
                            <Cell key={model.name} fill={model.name === selectedWalmartModel ? chartPalette.cyan : 'var(--bar-muted)'} />
                          ))}
                        </Bar>
                      </BarChart>
                    </ResponsiveContainer>
                  </div>
                  {walmartBest && (
                    <button type="button" className="inline-link" onClick={() => setSelectedWalmartModel(walmartBest.name)}>
                      Выбрать лучшую модель <ArrowUpRight size={14} />
                    </button>
                  )}
                </Card>

                <Card title="Почему прогноз такой?" subtitle="Факторы, которые объясняют расчёт на выбранный период." className="insights-card">
                  <div className="insight-list">
                    <div className="insight-item">
                      <span className="insight-icon holiday"><CalendarDays size={16} /></span>
                      <div>
                        <b>
                          {walmartHorizonRows.filter((r) => r.holiday).length
                            ? `Праздничный календарь: ${walmartHorizonRows.filter((r) => r.holiday).length} недели`
                            : 'Праздничный календарь'}
                        </b>
                        <p>
                          {walmartHorizonRows.filter((r) => r.holiday).length
                            ? `В горизонт попадают ${walmartHorizonRows.filter((r) => r.holiday).map((r) => `${r.holiday?.icon} ${r.holiday?.label}`).join(' и ')}. Эти недели дают всплески продаж.`
                            : 'В выбранный горизонт не попали праздничные недели из календаря.'}
                        </p>
                      </div>
                    </div>
                    <div className="insight-item">
                      <span className="insight-icon season"><TrendingUp size={16} /></span>
                      <div>
                        <b>Сезонность и недавний уровень</b>
                        <p>
                          {walmartHorizonStats.yoy >= 0 ? 'Прогноз выше' : 'Прогноз ниже'} того же периода
                          год назад на <strong>{formatNumber(Math.abs(walmartHorizonStats.yoy * 100), 1)}%</strong>.
                          Модель учитывает годовой цикл и текущие цены на топливо/CPI.
                        </p>
                      </div>
                    </div>
                    <div className="insight-item">
                      <span className="insight-icon scale"><ShoppingCart size={16} /></span>
                      <div>
                        <b>Масштаб магазина</b>
                        <p>
                          Store {walmartActiveStoreId} имеет базовый уровень{' '}
                          <strong>{formatSales(walmartTopStores.find((r) => r.store === walmartActiveStoreId)?.avg_sales ?? 0)}</strong>
                          {' '}в среднем за неделю. Поэтому абсолютный прогноз отличается от других магазинов
                          даже при схожей сезонности.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div className="insight-footnote">
                    <Info size={13} /> Источник — <code>artifacts/regression/walmart/report.json</code>. Разбиение train/test случайное, не по времени.
                  </div>
                </Card>
              </section>

              {/* ── Seasonality + Weekly table ────────────────────── */}
              <section className="two-column walmart-bottom-grid">
                <Card title="Сезонность по месяцам" subtitle="Средние продажи за доступную историю магазина.">
                  <div className="chart-area chart-medium">
                    <ResponsiveContainer width="100%" height="100%">
                      <BarChart data={walmartSeasonality} margin={{ top: 8, right: 8, bottom: 4, left: -8 }}>
                        <CartesianGrid strokeDasharray="3 5" vertical={false} stroke="var(--chart-grid)" />
                        <XAxis dataKey="month" tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <YAxis tickFormatter={(v) => `$${(v / 1_000_000).toFixed(1)}M`} tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <Tooltip content={<GenericTooltip valueFormatter={formatSales} />} />
                        <Bar dataKey="sales" name="Средние продажи" fill={chartPalette.purple} radius={[5, 5, 0, 0]} barSize={20} />
                      </BarChart>
                    </ResponsiveContainer>
                  </div>
                </Card>

                <Card
                  title="Прогноз по неделям"
                  subtitle={`Сумма на ${walmartHorizon} недель вперёд · YoY — к той же неделе год назад`}
                  right={<span className="small-tag">Store {walmartActiveStoreId}</span>}
                >
                  <div className="table-wrap weekly-table-wrap">
                    <table className="data-table">
                      <thead>
                        <tr><th>Неделя</th><th>Событие</th><th>Прогноз</th><th>YoY</th></tr>
                      </thead>
                      <tbody>
                        {walmartForecastRows.map((row) => (
                          <tr key={row.date}>
                            <td>{row.date}</td>
                            <td>
                              {row.holiday
                                ? <span className="holiday-chip">{row.holiday.icon} {row.holiday.label}</span>
                                : <span className="muted-cell">—</span>}
                            </td>
                            <td className="money-cell">{formatSales(row.forecast)}</td>
                            <td className={row.yoy >= 0 ? 'positive-text' : 'negative-text'}>{formatPercent(row.yoy)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <div className="table-note"><Info size={13} /> Все предсказания — на тестовой выборке.</div>
                </Card>
              </section>

              {/* ── Feature importance + Per-store MAPE ───────────── */}
              <section className="two-column lower-grid">
                <Card title="Важность факторов" subtitle="RandomForest importance из артефакта">
                  <div className="chart-area chart-medium">
                    <ResponsiveContainer width="100%" height="100%">
                      <BarChart
                        data={walmart.feature_importance.RandomForest ?? []}
                        layout="vertical"
                        margin={{ top: 4, right: 12, bottom: 4, left: 12 }}
                      >
                        <CartesianGrid strokeDasharray="3 5" horizontal={false} stroke="var(--chart-grid)" />
                        <XAxis type="number" tickFormatter={(v) => `${Math.round(v * 100)}%`} tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <YAxis dataKey="name" type="category" width={140} tickFormatter={(v) => WALMART_LABELS[v] ?? v} tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <Tooltip content={<GenericTooltip valueFormatter={(v) => `${formatNumber(v * 100, 1)}%`} />} />
                        <Bar dataKey="value" name="Важность" fill={chartPalette.purple} radius={[0, 5, 5, 0]} barSize={13} />
                      </BarChart>
                    </ResponsiveContainer>
                  </div>
                </Card>

                <Card
                  title="Per-store MAPE"
                  subtitle="Относительная ошибка по каждому магазину"
                  right={walmart.meta.store_spread ? (
                    <span className="small-tag">spread ×{formatNumber(walmart.meta.store_spread.ratio_max_min, 2)}</span>
                  ) : null}
                >
                  <div className="chart-area chart-medium">
                    <ResponsiveContainer width="100%" height="100%">
                      <BarChart data={walmartPerStore} layout="vertical" margin={{ top: 8, right: 20, bottom: 8, left: 12 }}>
                        <CartesianGrid strokeDasharray="3 5" horizontal={false} stroke="var(--chart-grid)" />
                        <XAxis type="number" tickFormatter={(v) => `${v}%`} tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <YAxis dataKey="store" type="category" width={54} tickFormatter={(v) => `#${v}`} tick={{ fill: 'var(--muted)', fontSize: 10 }} tickLine={false} axisLine={false} />
                        <Tooltip content={<GenericTooltip valueFormatter={(v) => `${formatNumber(v, 2)}%`} />} />
                        <Bar dataKey="mape" name="MAPE" radius={[0, 5, 5, 0]} barSize={12}>
                          {walmartPerStore.map((row) => (
                            <Cell key={row.store} fill={
                              walmartActiveStoreId === row.store ? chartPalette.cyan
                                : row.mape > 2 * (currentWalmartModel?.metrics.mape ?? 1) ? chartPalette.rose
                                : chartPalette.purple
                            } />
                          ))}
                        </Bar>
                      </BarChart>
                    </ResponsiveContainer>
                  </div>
                  <div className="chart-footnote">
                    <span>Розовым — магазины с MAPE &gt; 2× от среднего</span>
                    <span>Всего {walmartPerStore.length} магазинов в тесте</span>
                  </div>
                </Card>
              </section>

              {/* ── Table ─────────────────────────────────────────── */}
              <Card
                title="Таблица метрик"
                subtitle="Нажмите строку — переключится модель в графиках"
                right={<span className="small-tag">{walmart.models.length} моделей</span>}
              >
                <div className="table-wrap">
                  <table className="data-table">
                    <thead>
                      <tr><th>Модель</th><th>MAPE</th><th>MAE</th><th>RMSE</th><th>R²</th><th>MedAE</th><th>Max err.</th><th>CV MAPE</th></tr>
                    </thead>
                    <tbody>
                      {walmartModelsComparison.map((model) => (
                        <tr
                          key={model.name}
                          className={model.name === selectedWalmartModel ? 'row-selected' : ''}
                          onClick={() => setSelectedWalmartModel(model.name)}
                          tabIndex={0}
                          onKeyDown={(e) => { if (e.key === 'Enter') setSelectedWalmartModel(model.name) }}
                        >
                          <td><span className="model-cell">{model.name}{walmartBest && model.name === walmartBest.name && <span className="best-mark">BEST</span>}</span></td>
                          <td className="money-cell">{formatNumber(model.mape, 2)}%</td>
                          <td>{formatUsd(model.mae)}</td>
                          <td>{formatUsd(model.rmse)}</td>
                          <td>{formatNumber(model.r2, 3)}</td>
                          <td>{formatUsd(model.medae)}</td>
                          <td>{formatUsd(model.max_error)}</td>
                          <td>{model.cv_mape != null ? `${formatNumber(model.cv_mape, 2)}%` : '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <div className="table-note"><Info size={13} /> Источник — <code>artifacts/regression/walmart/report.json</code></div>
              </Card>
            </div>) : activeModule === 'property' ? null : null}

          <footer className="page-footer">
            <span>ML Hub <span className="footer-separator">/</span> Regression Console</span>
            <span>Housing &amp; Walmart — artifacts · Diamonds — demo</span>
          </footer>
        </div>
      </main>
    </div>
  )
}

function TargetIcon() {
  return <span className="target-icon">◎</span>
}

function RegressionScatterTooltip({ active, payload }: { active?: boolean; payload?: Array<{ payload: { actual: number; predicted: number } }> }) {
  if (!active || !payload?.length) return null
  const point = payload[0].payload
  return <div className="custom-tooltip"><b>Объект</b><span>Факт: {formatMoneyK(point.actual)}</span><span>Прогноз: {formatMoneyK(point.predicted)}</span><span>Ошибка: {formatMoneyK(point.predicted - point.actual)}</span></div>
}

function ResidualTooltip({ active, payload }: { active?: boolean; payload?: Array<{ payload: { predicted: number; residual: number } }> }) {
  if (!active || !payload?.length) return null
  const point = payload[0].payload
  return <div className="custom-tooltip"><b>Остаток модели</b><span>Прогноз: {formatMoneyK(point.predicted)}</span><span>Остаток: {formatMoneyK(point.residual)}</span></div>
}

function SalesTooltip({ active, payload }: { active?: boolean; payload?: Array<{ payload: { date: string; actual: number | null; forecast: number | null; low: number | null; high: number | null; holiday?: { icon: string; label: string } } }> }) {
  if (!active || !payload?.length) return null
  const point = payload[0].payload
  return <div className="custom-tooltip"><b>{point.date}</b>{point.holiday && <span>{point.holiday.icon} {point.holiday.label}</span>}{point.actual != null && <span>Факт: {formatSales(point.actual)}</span>}{point.forecast != null && <span>Прогноз: {formatSales(point.forecast)}</span>}{point.low != null && point.high != null && <span>95%: {formatSales(point.low)} – {formatSales(point.high)}</span>}</div>
}

function DiamondScatterTooltip({ active, payload }: { active?: boolean; payload?: Array<{ payload: { actual: number; predicted: number } }> }) {
  if (!active || !payload?.length) return null
  const point = payload[0].payload
  return <div className="custom-tooltip"><b>Цена бриллианта</b><span>Факт: {formatUsd(point.actual)}</span><span>Прогноз: {formatUsd(point.predicted)}</span><span>Ошибка: {formatUsd(point.predicted - point.actual)}</span></div>
}

function GenericTooltip({ active, payload, label, valueFormatter = (value: number) => formatNumber(value, 2) }: { active?: boolean; payload?: Array<{ value: number; name: string; color?: string }>; label?: string; valueFormatter?: (value: number) => string }) {
  if (!active || !payload?.length) return null
  return <div className="custom-tooltip"><b>{label}</b>{payload.map((entry, index) => <span key={`${entry.name}-${index}`}><i className="tooltip-dot" style={{ background: entry.color ?? chartPalette.cyan }} />{entry.name}: {valueFormatter(entry.value)}</span>)}</div>
}

export default RegressionConsole
