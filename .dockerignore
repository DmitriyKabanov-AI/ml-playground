Thumbs.db

# ---------- Логи / временное ----------
*.log
*.tmp
*.bak
tmp/
temp/
structure.txt
preview.log
preview.err.log
ps-output.txt

# ---------- Данные и артефакты (монтируются через volumes) ----------
data/
models/
artifacts/

# ---------- Junction на Windows ----------
# Junction-ссылки не переносятся в Linux-контейнер.
# Dockerfile создаёт пустые папки public/artifacts и public/models,
# а реальные данные приходят в nginx через volume из docker-compose.yml.
frontend/public/artifacts
frontend/public/models
# ---------- Spark bind-mounts (не должны попадать в образ) ----------
spark-state/
spark-apps/

# ---------- Логи (каталог, не только *.log) ----------
logs/

# ---------- Бинарные артефакты данных ----------
*.parquet
*.pkl
*.joblib
*.h5
*.pt
*.ckpt